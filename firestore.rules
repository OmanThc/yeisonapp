rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /pagos/{pagoId} {
      allow read, write: if true;
    }

    match /configuracion/{docId} {
      allow read, write: if true;
    }

    match /suscripciones/{docId} {
      allow read, write: if true;
    }

    match /fichas/{docId} {
      allow read, write: if true;
    }
  }
}
