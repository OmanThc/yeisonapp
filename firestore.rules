rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /pagos/{pagoId} {
      allow read: if true;
      allow create, update: if !pagoId.matches('pago-0.*');
      allow delete: if true;
    }

    match /configuracion/{docId} {
      allow read, write: if true;
    }

    match /suscripciones/{docId} {
      allow read, write: if true;
    }

    match /fichas/{docId} {
      allow read, write: if true;
    }

    // Trazas de diagnóstico de las notificaciones (app y servidor)
    match /notificaciones_debug/{docId} {
      allow read, write: if true;
    }
  }
}
